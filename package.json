{
  "name": "cli-tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "A modular TypeScript tic-tac-toe game for the terminal.",
  "type": "module",
  "scripts": {
    "start": "tsc && node dist/src/index.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
